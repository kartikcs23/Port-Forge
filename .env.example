# ================================================================
# PortForge Environment Variables
# Copy this file to .env and fill in your values
# ================================================================

# Server
PORT=5000
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/portforge
JWT_SECRET=your_jwt_secret_here
CLIENT_URL=http://localhost:5173

# Clerk instance issuer URL — used to verify auth tokens against Clerk's JWKS.
# Derived from your Clerk publishable key (the domain segment of pk_test_<base64>).
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# Google Gemini API Key for AI-assisted project scoring
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: GitHub personal access token — raises the GitHub API rate limit
# when syncing a user's repos (unauthenticated requests are capped at 60/hr).
GITHUB_TOKEN=

# Client (Vite)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
VITE_API_URL=http://localhost:5000
