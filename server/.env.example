# Application Port
PORT=5000

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/portforge

# Origin allowed by CORS — the deployed client URL in production.
CLIENT_URL=http://localhost:5173

# Secret used to sign JWTs for the legacy local email/password auth routes
# (POST /api/auth/register, /api/auth/login). Use a long random string in prod.
JWT_SECRET=your_jwt_secret_here

# Google Gemini API Key for AI Scoring
GEMINI_API_KEY=your_gemini_api_key_here

# Clerk instance issuer URL — used to fetch the JWKS for verifying auth tokens.
# Derived from your Clerk publishable key (the domain segment of pk_test_<base64>).
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# GitHub personal access token — raises the unauthenticated GitHub REST API
# rate limit (60/hr → 5000/hr) when syncing a user's repos, and is required
# to call the GitHub Models AI inference endpoint used for repo ranking
# (see /api/ranking). Generate one at github.com/settings/tokens — no scopes
# are required for public repo reads + Models access.
# NEVER commit a real value here — this file is a template, not a secret.
GITHUB_TOKEN=
